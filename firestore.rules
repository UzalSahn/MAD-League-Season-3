rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function activeAccount() {
      return request.auth != null
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.role == request.auth.token.role;
    }

    function canReadSeason(leagueId) {
      return activeAccount()
        && (request.auth.token.role == 'commissioner'
          || (exists(/databases/$(database)/documents/seasons/$(leagueId))
            && request.auth.uid in get(/databases/$(database)/documents/seasons/$(leagueId)).data.memberIds));
    }

    match /leagues/{leagueId} {
      allow read: if canReadSeason(leagueId);
      allow write: if false;
    }

    match /seasons/{seasonId} {
      allow read: if canReadSeason(seasonId);
      allow write: if false;
    }

    match /accounts/{accountId} {
      allow read, write: if false;
    }

    match /accountNames/{nameKey} {
      allow read, write: if false;
    }
  }
}
